# Copy the needed entries to .env.local. Never commit real credentials.
# auto: demo only when both MongoDB variables are absent; partial config fails closed.
# demo: always use in-memory synthetic readings, even if MongoDB is configured.
# mongodb: require complete config; never fall back to demo on failure.
MONITORING_MODE=auto

# Server-only. Do not add NEXT_PUBLIC_ prefixes.
MONGODB_URI=
MONGODB_DATABASE=
MONITORING_ORGANIZATION_ID=
MONITORING_SITE_ID=

# Live prototype access: HTTP Basic username "monitor", password = this token.
# Generate a random value of at least 32 characters. Deploy behind HTTPS.
# This temporary single-site gate will be replaced by MongoDB-backed user sessions.
MONITORING_ACCESS_TOKEN=
